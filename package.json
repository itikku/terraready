{
  "name": "terraready-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite apps/web --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit -p apps/web/tsconfig.json && vite build apps/web",
    "check": "tsc --noEmit -p apps/web/tsconfig.json && eslint apps/web/src tests/e2e playwright.config.ts",
    "test:e2e": "playwright test",
    "format:check": "prettier --check 'apps/web/src/**/*.{ts,tsx,css}' 'tests/e2e/*.ts' playwright.config.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "lucide-react": "^0.468.0",
    "mapbox-gl": "^3.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.56.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.0"
  }
}
